{
  "openapi": "3.1.0",
  "info": {
    "title": "IMRC Live API",
    "version": "1.3.0",
    "description": "Public RC racing data for IMRC Setup Manager. Read operations need no authentication. Authoritative publishing from IMRC Race Control uses per-track upload keys. Poll no faster than 1 second. Live responses include mode and practice; GET /tracks/{trackId}/practice exposes the current practice snapshot. Snapshot POST accepts optional practice {id:current,active,drivers}; each driver has id (stint only), name, laps, lastLap, best, average, lastCrossingAt, lapTimes (latest 1000), stats [{label,value}]. Maximum 100 drivers; same authorization and retention as other live data. SSE: GET /tracks/{trackId}/stream emits live events containing {apiVersion:1,data:Live}; fresh snapshots on changes and at most 15 seconds apart, connection renews after about 55 seconds. Retry after 1 second. Not guaranteed instant. Native apps may use SSE or poll /live once per second."
  },
  "servers": [
    {
      "url": "https://live.shopimrc.com/api/v1"
    }
  ],
