                          ]
                        }
                      },
                      "required": [
                        "items",
                        "nextOffset"
                      ]
                    }
                  },
                  "required": [
                    "apiVersion",
                    "data"
                  ]
                }
              }
            }
          },
          "304": {
            "description": "Unchanged; no body"
          },
          "400": {
            "description": "Invalid query"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
