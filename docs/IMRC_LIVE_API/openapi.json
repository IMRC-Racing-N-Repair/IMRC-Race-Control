    "/register": {
      "servers": [
        {
          "url": "https://live.shopimrc.com/api"
        }
      ],
      "post": {
        "summary": "Register a new desktop track without user sign-in",
        "description": "Generate and securely persist a 32-byte random hexadecimal key before the first request. Send it as Bearer authorization and reuse it for retries and publishing. Existing registrations require the same key; no profile edits or key rotation are permitted here. Only IMRC may restore deleted UUIDs.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer followed by the privately persisted registration key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "uuid",
                  "name",
                  "location",
                  "surface"
                ],
                "properties": {
                  "uuid": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "surface": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered or existing matching key; data contains id, name and registered:true"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Cross-origin write rejected"
          },
          "409": {
            "description": "Existing UUID uses another key"
          },
          "410": {
            "description": "UUID deleted by administrator"
          }
        }
      }
    },
    "/tracks/{trackId}/practice": {
      "get": {
        "summary": "Current live practice",
        "parameters": [
          {
            "name": "trackId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "data contains track, practice (nullable, with active, drivers, updatedAt and stale), pollAfterSeconds"
          },
          "404": {
            "description": "Track not found"
          }
        }
      }
    },
    "/tracks/{trackId}/stream": {
      "get": {
        "summary": "Persistent live timing stream (SSE)",
        "parameters": [
          {
            "name": "trackId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE live event JSON envelope; unavailable event signals missing track or feed error",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Track not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "TrackUploadKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Driver": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "carNumber": {
            "type": "integer",
            "minimum": 0
          },
          "laps": {
            "type": "integer",
            "minimum": 0
          },
          "time": {
            "type": "string"
          },
          "best": {
            "type": "string"
          },
          "lastLap": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "finished": {
            "type": "boolean"
          },
          "lapTimes": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "maxItems": 20000
          }
        },
        "required": [
          "name",
          "position",
          "laps",
          "time"
        ]
      },
      "Race": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "round": {
            "type": "string"
          },
          "classId": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "heat": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "live",
              "completed",
              "skipped"
            ]
          },
          "drivers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Driver"
            },
            "maxItems": 30
          }
        },
        "required": [
          "id",
          "number",
          "round",
          "className",
          "heat",
          "status",
          "drivers"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "upcoming",
              "active",
              "completed"
            ]
          },
          "races": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Race"
            },
            "maxItems": 2000
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "date",
          "status",
          "races"
        ]
      },
      "SeriesDriver": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "number"
          },
          "manualPoints": {
            "type": "number"
          },
          "points": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "maxItems": 1000
          },
          "counted": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 1000
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4000
            },
            "maxItems": 1000
          }
        },
        "required": [
          "name",
          "points"
        ]
      },
      "Series": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "className": {
            "type": "string"
          },
          "classId": {
            "type": "string"
          },
          "bestOf": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "weeks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          },
          "eventIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          },
          "authoritative": {
            "type": "boolean",
            "description": "When true, each driver must provide position, total and counted indexes from Race Control."
          },
          "drivers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeriesDriver"
            },
            "maxItems": 5000
          }
        },
        "required": [
          "id",
          "name",
          "className",
          "bestOf",
          "weeks",
          "drivers"
        ]
      },
      "Track": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currentEventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastReceivedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "location",
          "surface",
          "updatedAt"
        ]
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "localTrackId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9-]{32,36}$"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currentEventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "maxItems": 100
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Series"
            },
            "maxItems": 100
          },
          "practice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Practice"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schemaVersion",
          "localTrackId",
          "generatedAt",
          "currentEventId"
        ]
      },
      "Live": {
        "type": "object",
        "properties": {
          "track": {
            "$ref": "#/components/schemas/Track"
          },
          "event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Event"
              },
              {
                "type": "null"
              }
            ]
          },
          "races": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Race"
            }
          },
          "generatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "receivedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "stale": {
            "type": "boolean"
          },
          "pollAfterSeconds": {
            "type": "integer"
          },
          "mode": {
            "enum": [
              "race",
              "practice"
            ]
          },
          "practice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PracticeLive"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "track",
          "event",
          "races",
          "stale",
          "pollAfterSeconds",
          "mode",
          "practice"
        ]
      },
      "EventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "raceCount": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "SeriesSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "classId": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "bestOf": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "integer",
            "const": 1
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "apiVersion",
          "error"
        ]
      },
      "Practice": {
        "type": "object",
        "properties": {
          "id": {
            "const": "current"
          },
          "active": {
            "type": "boolean"
          },
          "drivers": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160
                },
                "name": {
                  "type": "string",
                  "maxLength": 160
                },
                "lastLap": {
                  "type": "string",
                  "maxLength": 160
                },
                "best": {
                  "type": "string",
                  "maxLength": 160
                },
                "average": {
                  "type": "string",
                  "maxLength": 160
                },
                "laps": {
                  "type": "integer",
                  "minimum": 0
                },
                "lastCrossingAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "lapTimes": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "stats": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 160
                      }
                    },
                    "required": [
                      "label",
                      "value"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "lastLap",
                "best",
                "average",
                "laps",
                "lastCrossingAt",
                "lapTimes",
                "stats"
              ]
            }
          }
        },
        "required": [
          "id",
          "active",
          "drivers"
        ]
      },
      "PracticeLive": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Practice"
          },
          {
            "type": "object",
            "properties": {
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "stale": {
                "type": "boolean"
              }
            },
            "required": [
              "updatedAt",
              "stale"
            ]
          }
        ]
      }
    }
  }
}
