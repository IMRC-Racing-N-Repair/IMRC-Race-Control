<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IMRCRaceControl</AssemblyName>
    <RootNamespace>IMRCRaceControl</RootNamespace>
    <Version>0.16.18</Version>
    <StartupObject>IMRCRaceControl.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/IMRC-Original.png" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="NetMQ" Version="4.0.4.3" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
