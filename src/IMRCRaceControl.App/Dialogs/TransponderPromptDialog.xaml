<Window x:Class="IMRCRaceControl.Dialogs.TransponderPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transponder"
        Width="430" Height="210"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="CHANGE TRANSPONDER" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="DriverText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Transponder number" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="TransponderText"/>
            <TextBlock Text="Use semicolons if the racer intentionally has more than one transponder."
                       Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" MinWidth="90" Click="Cancel_Click"/>
            <Button Content="SAVE" MinWidth="90" Click="Save_Click"
                    Background="{DynamicResource GoodBrush}" Foreground="#101318"/>
        </StackPanel>
    </Grid>
</Window>
