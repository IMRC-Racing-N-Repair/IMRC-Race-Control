<Window x:Class="IMRCRaceControl.Dialogs.DriverEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver"
        Width="500" Height="485"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DialogTitleText" Text="ADD DRIVER" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="First name is required. Last name and nickname are optional."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,14"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" CornerRadius="0" Padding="14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="First name *" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="FirstNameText"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Last name (optional)" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="LastNameText"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nickname / scoring display (optional)"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                <TextBox x:Name="NicknameText"/>
                <TextBlock Text="If a nickname is entered, Race Control displays it. If blank, it displays first and last name."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,-6,0,0"/>
                <TextBlock Text="Phonetic nickname / name — say it like (optional)"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="TEST NAME" Click="TestName_Click"/>
                    <TextBox x:Name="PhoneticNameText" MaxLength="120"/>
                </DockPanel>
                <TextBlock Text="Example: nickname Yoshi → Yoh shee. Changes pronunciation only. TEST NAME uses your selected announcement voice. Leave blank to speak the scoring display name."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="CANCEL" MinWidth="95" Click="Cancel_Click"/>
            <Button Content="SAVE DRIVER" MinWidth="125" Click="Save_Click"
                    Background="{DynamicResource GoodBrush}" Foreground="#101318"/>
        </StackPanel>
    </Grid>
</Window>
