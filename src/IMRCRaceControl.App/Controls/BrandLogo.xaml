<UserControl x:Class="IMRCRaceControl.Controls.BrandLogo"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
 <Viewbox Stretch="Uniform">
  <Grid Width="640" Height="240">
   <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Source="/IMRCRaceControl;component/Assets/RC-Approved.png" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
    <TextBlock Text="IMRC" FontFamily="Segoe UI" FontSize="76" FontWeight="Black" Foreground="{DynamicResource TextBrush}"/>
    <TextBlock Text="RACE CONTROL" FontFamily="Segoe UI" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
   </StackPanel>
  </Grid>
 </Viewbox>
</UserControl>
