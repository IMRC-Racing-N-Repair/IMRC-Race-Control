<Application x:Class="IMRCRaceControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Core palette -->
        <SolidColorBrush x:Key="PageBrush" Color="#101214"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171A1D"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202428"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#2A3035"/>
        <SolidColorBrush x:Key="InputBrush" Color="#131619"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30363C"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#626D77"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AAB6C7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E34B4B"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#7E2E35"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#42CE82"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#F1C75B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF6A6A"/>
        <SolidColorBrush x:Key="HoneycombLineBrush" Color="#365B78"/>
        <SolidColorBrush x:Key="DashboardBackgroundBrush" Color="#101214"/>
        <SolidColorBrush x:Key="DashboardPanelBrush" Color="#171A1D"/>
        <SolidColorBrush x:Key="DashboardRowBrush" Color="#131619"/>
        <SolidColorBrush x:Key="DashboardAlternateRowBrush" Color="#191E22"/>
        <SolidColorBrush x:Key="DashboardTextBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="DashboardPassingHighlightBrush" Color="#7E2E35"/>
        <SolidColorBrush x:Key="DashboardPassingHighlightAccentBrush" Color="#E34B4B"/>
        <SolidColorBrush x:Key="DashboardPassingHighlightTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DashboardFastestLapHighlightBrush" Color="#3A3212"/>
        <SolidColorBrush x:Key="DashboardFastestLapHighlightTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DashboardNewBestLapHighlightBrush" Color="#0E5B45"/>
        <SolidColorBrush x:Key="DashboardNewBestLapHighlightTextBrush" Color="#FFFFFF"/>

        <DrawingBrush x:Key="HoneycombPatternBrush"
                      TileMode="Tile"
                      Viewport="0,0,58,34"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,58,34"
                      ViewboxUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent"
                                     Geometry="M 14.5,0 L 43.5,0 58,17 43.5,34 14.5,34 0,17 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{DynamicResource HoneycombLineBrush}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="Transparent"
                                     Geometry="M 43.5,-17 L 72.5,-17 87,0 72.5,17 43.5,17 29,0 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{DynamicResource HoneycombLineBrush}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Override native light-theme fallback brushes used by stock WPF controls. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#131619"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#202428"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#7E2E35"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#78869A"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="4"><StackPanel IsItemsHost="True"/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource PanelHoverBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Background="{DynamicResource BorderStrongBrush}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
                <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.18"/></Border.Effect>
                        </Border>
                        <Border CornerRadius="5" IsHitTestVisible="False">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#12FFFFFF" Offset="0"/><GradientStop Color="#00000000" Offset="0.5"/><GradientStop Color="#10000000" Offset="1"/>
                            </LinearGradientBrush></Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonRoot" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonRoot" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource {x:Type ComboBoxItem}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"/>

                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"/>

                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Style="{x:Null}"
                                         Margin="{TemplateBinding Padding}"
                                         Background="Transparent"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{DynamicResource TextBrush}"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Visibility="Hidden"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>

                                <ToggleButton x:Name="DropDownToggle"
                                              Grid.Column="1"
                                              Focusable="False"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" CornerRadius="0,4,4,0">
                                                <Path Width="10" Height="6"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{DynamicResource MutedBrush}"
                                                      Data="M 0 0 L 5 5 L 10 0 Z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelAltBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="1,1,1,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0,8,0,10"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid Margin="0,2,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5,0,7">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Custom tab chrome prevents Windows light theme from turning selected tabs white. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,2"
                                CornerRadius="0">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideNavigationTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,5,2"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3,0,0,0"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource PageBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource {x:Type DataGridColumnHeader}}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="HeaderChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      RecognizesAccessKey="True"/>
                                    <Path x:Name="SortArrow" Grid.Column="1" Margin="5,0,0,0"
                                          Width="8" Height="5" VerticalAlignment="Center"
                                          Fill="{TemplateBinding Foreground}" Visibility="Collapsed"
                                          Data="M 0 5 L 4 0 L 8 5 Z"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 5 L 8 0 Z"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CellChrome" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CellChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="MinHeight" Value="22"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DriverCrossingBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLastPassing}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DriverCrossingBrush}"/>
                    <Setter Property="BorderThickness" Value="{DynamicResource DriverCrossingThickness}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RaceDriverBorderStyle" TargetType="Border" BasedOn="{StaticResource DriverCrossingBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCheckedIn}" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashboardCheckInGlowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLastPassing}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DriverCrossingBrush}"/>
                    <Setter Property="BorderThickness" Value="{DynamicResource DriverCrossingThickness}"/>
                </DataTrigger>
                <!-- Breakout has priority over check-in and crossing, including underline mode. -->
                <DataTrigger Binding="{Binding IsMinimumLapViolationGlow}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashboardMinimumLapGlowBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="RacePositionTemplate">
            <Border x:Name="PositionOutline" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="4,8" Margin="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Position}" TextAlignment="Center" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFinished}" Value="True">
                    <Setter TargetName="PositionOutline" Property="BorderBrush" Value="#FFD54F"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="RaceDriverNameTemplate">
            <Border Style="{StaticResource RaceDriverBorderStyle}">
                <TextBlock Text="{Binding DriverName}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>
        <Style x:Key="SharedDashboardCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SharedDashboardRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource DashboardTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DashboardRowBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Tag" Value="{DynamicResource FinishedDriverStyle}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource DashboardAlternateRowBrush}"/></Trigger>
                <DataTrigger Binding="{Binding IsFastestLap}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DashboardFastestLapHighlightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DashboardFastestLapHighlightTextBrush}"/>
                </DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFinished}" Value="True"/>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Row"/>
                </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource FinishedDriverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource FinishedDriverContrastBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFinished}" Value="True"/>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Text"/>
                </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource FinishedDriverBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
<DataTemplate x:Key="SharedPracticeCardTemplate">
                                                <Border Margin="3"
                                                        Background="{DynamicResource DashboardPanelBrush}"
                                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        CornerRadius="0"
                                                        Padding="3">
                                                    <!--
                                                        The card uses a fixed design surface and a Viewbox.
                                                        With two rows it renders at normal spectator size.
                                                        As a third/fourth/etc. row becomes necessary, the
                                                        entire card scales down proportionally so up to 36
                                                        active racers remain visible.
                                                    -->
                                                    <Viewbox Stretch="Uniform"
                                                             StretchDirection="Both"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch">
                                                        <Grid Width="310" Height="320" Margin="3">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="48"/>
                                                                <RowDefinition Height="54"/>
                                                                <RowDefinition Height="62"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="20"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Driver -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel VerticalAlignment="Center">
                                                                    <Border Style="{StaticResource DriverCrossingBorderStyle}" Padding="4,1"><TextBlock Text="{Binding DriverName}"
                                                                               FontSize="20"
                                                                               FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource DashboardTextBrush}"/></Border>
                                                                    <TextBlock Text="{Binding TransponderId, StringFormat='Transponder: {0}'}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding LapCount, StringFormat='Laps {0}'}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Margin="8,0,2,0"/>
                                                            </Grid>

                                                            <!-- Primary timing -->
                                                            <UniformGrid Grid.Row="1" Columns="3">
                                                                <StackPanel Margin="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="LAST"
                                                                               TextAlignment="Center"
                                                                               FontSize="9"
                                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding LastLapDisplay}"
                                                                               TextAlignment="Center"
                                                                               FontSize="16"
                                                                               FontWeight="Bold"/>
                                                                </StackPanel>

                                                                <StackPanel Margin="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="BEST"
                                                                               TextAlignment="Center"
                                                                               FontSize="9"
                                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding BestLapDisplay}"
                                                                               TextAlignment="Center"
                                                                               FontSize="16"
                                                                               FontWeight="Bold"/>
                                                                </StackPanel>

                                                                <StackPanel Margin="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="AVERAGE"
                                                                               TextAlignment="Center"
                                                                               FontSize="9"
                                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding AverageLapDisplay}"
                                                                               TextAlignment="Center"
                                                                               FontSize="16"
                                                                               FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </UniformGrid>

                                                            <!-- Operator-selected live stats -->
                                                            <ItemsControl Grid.Row="2"
                                                                          ItemsSource="{Binding VisibleStats}"
                                                                          Margin="0,2">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="2"
                                                                                Padding="3"
                                                                                Background="{DynamicResource PanelAltBrush}"
                                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="2">
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Label}"
                                                                                           TextAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           FontSize="8.5"
                                                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                                                <TextBlock Text="{Binding Value}"
                                                                                           TextAlignment="Center"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="13"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Lap history -->
                                                            <Border Grid.Row="3"
                                                                    Margin="0,3,0,2"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2"
                                                                    ClipToBounds="True">
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                              HorizontalScrollBarVisibility="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding Laps}"
                                                                                  AlternationCount="2">
                                                                        <ItemsControl.ItemContainerStyle>
                                                                            <Style TargetType="ContentPresenter">
                                                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                                            </Style>
                                                                        </ItemsControl.ItemContainerStyle>

                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Padding="5,3"
                                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                                        BorderThickness="0,0,0,1">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background"
                                                                                                    Value="{DynamicResource DashboardRowBrush}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger
                                                                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                                                    Value="1">
                                                                                                    <Setter Property="Background"
                                                                                                            Value="{DynamicResource DashboardAlternateRowBrush}"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>

                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="52"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="95"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <TextBlock Text="{Binding LapNumber, StringFormat='Lap {0}'}"
                                                                                                   FontSize="10"
                                                                                                   FontWeight="SemiBold"/>

                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Text="{Binding LapTimeDisplay}"
                                                                                                   TextAlignment="Center"
                                                                                                   FontSize="12"
                                                                                                   FontWeight="Bold"/>

                                                                                        <TextBlock Grid.Column="2"
                                                                                                   Text="{Binding Source}"
                                                                                                   TextAlignment="Right"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   FontSize="9"
                                                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </Border>

                                                            <TextBlock Grid.Row="4"
                                                                       Text="{Binding InactivityDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource MutedBrush}"/>
                                                        </Grid>
                                                    </Viewbox>
                                                </Border>
                                            </DataTemplate>
    </Application.Resources>
</Application>
