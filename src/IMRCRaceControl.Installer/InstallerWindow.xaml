<Window x:Class="IMRCRaceControl.Installer.InstallerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IMRC Race Control Installer" Width="760" Height="540" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
 <Border Background="#14171D" BorderBrush="#3B424F" BorderThickness="1" CornerRadius="10" Margin="8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="5"/><RowDefinition Height="126"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
   <Border Background="#DB3545" CornerRadius="10,10,0,0"/>
   <Grid Grid.Row="1" Background="#1C2028" MouseLeftButtonDown="DragHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
    <Image Source="Assets/RC.png" Width="104" Height="104" Margin="20,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="IMRC RACING N REPAIR" FontSize="11" Foreground="#AAB3C1"/>
     <TextBlock Text="RACE CONTROL" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/>
     <TextBlock Text="INSTALLATION &amp; UPDATES" FontSize="11" Foreground="#ED7B86" Margin="0,5,0,0"/>
    </StackPanel>
    <Button x:Name="CloseButton" Grid.Column="2" Content="&#x2715;" AutomationProperties.Name="Close installer" Click="CloseClicked" Padding="8" Margin="4,10,10,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"/>
   </Grid>
   <Grid Grid.Row="2" Margin="30,22,30,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="Description" Grid.Row="1" FontSize="14" Foreground="#B9C1CE" TextWrapping="Wrap" Margin="0,8,0,18"/>
    <Grid Grid.Row="2" Margin="0,0,0,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="INSTALLED VERSION" FontSize="10" Foreground="#8F9BAD"/><TextBlock x:Name="CurrentVersion" FontSize="19" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="INSTALLER VERSION" FontSize="10" Foreground="#8F9BAD"/><TextBlock x:Name="TargetVersion" FontSize="19" Margin="0,4,0,0" Foreground="#F27A86"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="3"><TextBlock Text="INSTALL LOCATION" FontSize="10" Foreground="#8F9BAD"/><TextBlock x:Name="InstallLocation" FontSize="12" Foreground="#B9C1CE" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
    <TextBlock x:Name="Status" Grid.Row="4" FontSize="12" Foreground="#E6AFB6" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Grid.Row="5">
     <ProgressBar x:Name="Activity" Height="4" Visibility="Collapsed" IsIndeterminate="True" AutomationProperties.Name="Installation in progress" Margin="0,5,0,12">
      <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border Background="#2E3542" CornerRadius="2" ClipToBounds="True"><Canvas><Rectangle Width="160" Height="4" Fill="#DB3545"><Rectangle.RenderTransform><TranslateTransform x:Name="Slide" X="-160"/></Rectangle.RenderTransform></Rectangle></Canvas></Border><ControlTemplate.Triggers><Trigger Property="Visibility" Value="Visible"><Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" From="-160" To="700" Duration="0:0:1.7"/></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger></ControlTemplate.Triggers></ControlTemplate></ProgressBar.Template>
     </ProgressBar>
     <TextBlock Text="Your saved race data stays in place." Foreground="#8F9BAD" FontSize="12"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#303744" BorderThickness="0,1,0,0" Background="#191D25" CornerRadius="0,0,10,10">
    <Grid Margin="24,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="FolderButton" Content="Open install folder" Click="FolderClicked" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,10" FontSize="12"/>
     <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CloseClicked" Margin="0,0,10,0"/>
     <Button x:Name="ActionButton" Grid.Column="2" Content="Install Race Control" Click="ActionClicked" Background="#C82F40" BorderBrush="#E85B6A" MinWidth="176" IsDefault="True"/>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
