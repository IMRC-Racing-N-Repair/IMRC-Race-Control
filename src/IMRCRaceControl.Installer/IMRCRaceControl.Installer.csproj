<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RaceControl-Installer</AssemblyName>
    <RootNamespace>IMRCRaceControl.Installer</RootNamespace>
    <StartupObject>IMRCRaceControl.Installer.Program</StartupObject>
    <Version>0.16.24</Version>
    <ApplicationIcon>../IMRCRaceControl.App/Assets/RC.ico</ApplicationIcon>
    <ApplicationManifest>../IMRCRaceControl.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../IMRCRaceControl.App/Assets/RC-Approved.png" Link="Assets/RC.png" />
    <EmbeddedResource Include="$(InstallerPayload)" LogicalName="RaceControl.Setup.exe" Condition="Exists('$(InstallerPayload)')" />
  </ItemGroup>
  <Target Name="RequireInstallerPayload" BeforeTargets="Publish" Condition="!Exists('$(InstallerPayload)')">
    <Error Text="Build the Velopack payload before publishing the themed installer." />
  </Target>
</Project>
